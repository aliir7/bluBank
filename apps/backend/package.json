{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "fastify": "5.12.7",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@swc/cli": "^0.8.0",
    "@swc/core": "1.15.33",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "globals": "catalog:",
    "pino-pretty": "^13.2.0",
    "rimraf": "catalog:",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
