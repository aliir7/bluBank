# Runtime environment: development or production.
NODE_ENV=development

# Host interface the API listens on.
HOST=0.0.0.0

# Port the API listens on.
PORT=4000

# Log level. Defaults to debug in development and info otherwise.
LOG_LEVEL=debug


# Request body limit in bytes. Can only be lowered: the maximum is 1048576 (1 MB).
BODY_LIMIT_BYTES=1048576

# Comma-separated allowed browser origins. Required in production.
CORS_ORIGINS=

# Trust forwarded client IP headers from proxies.
TRUST_PROXY=false

# Redis connection settings.
REDIS_HOST=localhost
REDIS_PORT=6379
# Set only when Redis requires authentication.
# REDIS_PASSWORD=
REDIS_DB=0

# Prepended to every key to avoid collisions when Redis is shared.
REDIS_KEY_PREFIX=blubank:
